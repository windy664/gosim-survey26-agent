# Copy this file to .env to run the agent locally. Never commit a real .env or upload it in a
# submission ZIP -- on the platform these variables are injected for you automatically, pointing
# at the platform's own model proxy and a temporary run credential.

# Any OpenAI-compatible /chat/completions endpoint. Defaults to the Kimi Coding Plan endpoint
# below when unset; see https://www.kimi.com/code/docs/en/ for details.
#   https://api.kimi.com/coding/v1             (Kimi Coding Plan, default)
#   https://api.kimi.ai/coding/v1               (Kimi Coding Plan, overseas endpoint)
#   https://api.openai.com/v1                   (OpenAI)
#   http://127.0.0.1:11434/v1                   (a local OpenAI-compatible proxy)
OPENAI_BASE_URL=https://api.kimi.com/coding/v1

# Your API key for that endpoint. Keep this out of version control and out of any submission ZIP.
# KIMI_API_KEY also works in place of OPENAI_API_KEY.
OPENAI_API_KEY=your-key-here

# Model id for that endpoint. Defaults to "k3" (Kimi Coding Plan) when unset.
OPENAI_MODEL=k3
