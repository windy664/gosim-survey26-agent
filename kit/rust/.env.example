# Copy to .env for local runs only -- never commit a real key, and the official
# packer / platform upload must not include a .env with a real key either.
#
# A key is required: set OPENAI_API_KEY (or KIMI_API_KEY) below. With neither
# set, the agent logs "missing API key: set OPENAI_API_KEY" and exits.
#
# On the platform (cloud runs and the official local project runner) OPENAI_BASE_URL
# and OPENAI_API_KEY are injected for you: the platform's model proxy and a temporary
# run credential. They take precedence over everything below.
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# Default endpoint/model, if OPENAI_BASE_URL / OPENAI_MODEL are left unset: the
# Kimi Coding Plan (https://www.kimi.com/code/docs/en/), an OpenAI-compatible
# chat-completions API.
#   OPENAI_BASE_URL=https://api.kimi.com/coding/v1   (default; mainland China)
#   OPENAI_BASE_URL=https://api.kimi.ai/coding/v1     (overseas)
#   OPENAI_MODEL=k3                                   (default)
#   OPENAI_API_KEY=<your-kimi-coding-plan-key>
#
# Any other OpenAI-compatible chat-completions endpoint works the same way --
# just set OPENAI_BASE_URL / OPENAI_MODEL / OPENAI_API_KEY accordingly.
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=
# Accepted in place of OPENAI_API_KEY, for a Kimi-only key:
KIMI_API_KEY=

# Per-call timeout, the total time budget across the whole run, and the hard
# cap on how many LLM calls one run may make -- see README "LLM usage". A
# failed/timed-out call is retried a few times before that night's plan uses
# its own numbers for that step; the next scheduled call still runs normally.
LLM_TIMEOUT_SECONDS=12
LLM_BUDGET_SECONDS=300
LLM_MAX_CALLS=100
